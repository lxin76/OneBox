<Window x:Class="OneBox.Plugins.TextPin.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OneBox 置顶文本设置"
        Icon="pack://application:,,,/Assets/app.ico"
        Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{DynamicResource Theme.Surface}" Foreground="{DynamicResource Theme.Text}" FontSize="12">
    <Window.Resources>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource Theme.Text}"/>
            <Setter Property="Margin" Value="0,3,0,6"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource Theme.ButtonBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource Theme.Text}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Theme.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Theme.ButtonHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Theme.ButtonPressed}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource Theme.InputBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource Theme.TextInput}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource Theme.TextInput}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Theme.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </Window.Resources>

    <StackPanel Margin="22,18,22,16">
        <TextBlock Text="常规" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource Theme.TextStrong}" Margin="0,0,0,8"/>
        <CheckBox x:Name="PinnedCheck" Content="窗口置顶（始终保持在上层）"
                  Checked="OnPinnedChanged" Unchecked="OnPinnedChanged"/>
        <CheckBox x:Name="NoActivateCheck" Content="不抢焦点（点击窗口不打断当前软件）"
                  Checked="OnNoActivateChanged" Unchecked="OnNoActivateChanged"/>
        <CheckBox x:Name="AutoPasteCheck" Content="复制后自动粘贴到前台窗口"
                  Checked="OnAutoPasteChanged" Unchecked="OnAutoPasteChanged"/>
        <CheckBox x:Name="WordWrapCheck" Content="自动换行"
                  Checked="OnWordWrapChanged" Unchecked="OnWordWrapChanged"/>
        <CheckBox x:Name="AutoStartCheck" Content="开机自动启动"
                  Checked="OnAutoStartChanged" Unchecked="OnAutoStartChanged"/>
        <TextBlock x:Name="AutoStartTip" Foreground="{DynamicResource Theme.TextMuted}" FontSize="11" Margin="22,0,0,6" TextWrapping="Wrap"/>
        <Grid Margin="0,2,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="字号：" Foreground="{DynamicResource Theme.Text}" VerticalAlignment="Center"/>
            <TextBox x:Name="FontSizeBox" Grid.Column="1" Width="70" Padding="6,3" Margin="10,0,0,0"
                     LostFocus="OnFontSizeLostFocus" KeyDown="OnFontSizeKeyDown"/>
            <TextBlock Grid.Column="2" Text="长度上限：" Foreground="{DynamicResource Theme.Text}" VerticalAlignment="Center" Margin="20,0,0,0"/>
            <TextBox x:Name="MaxLengthBox" Grid.Column="3" Width="110" Padding="6,3" Margin="10,0,0,0"
                     HorizontalAlignment="Left"
                     LostFocus="OnMaxLengthLostFocus" KeyDown="OnMaxLengthKeyDown"/>
        </Grid>

        <TextBlock Text="全局热键" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource Theme.TextStrong}" Margin="0,16,0,6"/>
        <Grid Margin="0,2,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="显示/隐藏文本框" Foreground="{DynamicResource Theme.Text}" VerticalAlignment="Center"/>
            <Button x:Name="ToggleHotkeyButton" Grid.Column="1" Width="170" HorizontalAlignment="Left"
                    Click="OnRecordToggleHotkey"/>
        </Grid>
        <Grid Margin="0,2,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="读入剪贴板文本" Foreground="{DynamicResource Theme.Text}" VerticalAlignment="Center"/>
            <Button x:Name="PasteHotkeyButton" Grid.Column="1" Width="170" HorizontalAlignment="Left"
                    Click="OnRecordPasteHotkey"/>
        </Grid>
        <Grid Margin="0,2,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="复制文本到剪贴板" Foreground="{DynamicResource Theme.Text}" VerticalAlignment="Center"/>
            <Button x:Name="CopyHotkeyButton" Grid.Column="1" Width="170" HorizontalAlignment="Left"
                    Click="OnRecordCopyHotkey"/>
        </Grid>
        <Grid Margin="0,2,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="抓取选中文字" Foreground="{DynamicResource Theme.Text}" VerticalAlignment="Center"/>
            <Button x:Name="CaptureHotkeyButton" Grid.Column="1" Width="170" HorizontalAlignment="Left"
                    Click="OnRecordCaptureHotkey"/>
        </Grid>
        <TextBlock x:Name="HotkeyWarningText" Foreground="{DynamicResource Theme.Warn}" FontSize="11" TextWrapping="Wrap"
                   Margin="0,4,0,0" Visibility="Collapsed"/>
        <TextBlock Text="点击热键按钮后按下新组合键（需含 Ctrl/Alt/Shift/Win 之一）。" Foreground="{DynamicResource Theme.TextMuted}" FontSize="11" Margin="0,4,0,0"/>
        <TextBlock Text="本插件不监听剪贴板：只有点击「读入」或按读入热键时才会读一次剪贴板。" Foreground="{DynamicResource Theme.TextMuted}" FontSize="11" Margin="0,2,0,0"/>
        <TextBlock Text="在任意编辑器选中文字后按『抓取选中文字』热键：自动模拟 Ctrl+C 复制并置顶。" Foreground="{DynamicResource Theme.TextMuted}" FontSize="11" Margin="0,2,0,0"/>
        <TextBlock Text="键盘输入异常时，可用 Ctrl+Alt+K 或托盘菜单重置修饰键。" Foreground="{DynamicResource Theme.TextMuted}" FontSize="11" Margin="0,2,0,0"/>

        <TextBlock Text="数据" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource Theme.TextStrong}" Margin="0,16,0,6"/>
        <TextBlock x:Name="DataDirText" Foreground="{DynamicResource Theme.TextMuted}" TextWrapping="Wrap" Margin="0,1,0,8"/>
        <StackPanel Orientation="Horizontal">
            <Button Content="打开数据目录" Click="OnOpenDataDir" Margin="0,0,8,0"/>
            <Button Content="清空文本" Click="OnClearText" Foreground="{DynamicResource Theme.Error}"/>
        </StackPanel>

        <TextBlock Text="设置修改后自动保存。" Foreground="{DynamicResource Theme.TextFaint}" FontSize="11" Margin="0,14,0,0"/>
    </StackPanel>
</Window>