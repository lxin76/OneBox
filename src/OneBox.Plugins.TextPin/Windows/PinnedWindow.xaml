<Window x:Class="OneBox.Plugins.TextPin.Windows.PinnedWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OneBox 置顶文本"
        Icon="pack://application:,,,/Assets/app.ico"
        Width="420" Height="260" MinWidth="240" MinHeight="120"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        MouseLeftButtonDown="OnDragStart">
    <Window.Resources>
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource Theme.Text}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="15">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Theme.OverlayHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Theme.OverlayPressed}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="RootBorder" CornerRadius="16" Background="{DynamicResource Theme.Floating}"
            BorderBrush="{DynamicResource Theme.FloatingBorder}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 标题栏：可拖动；按钮不参与拖动也不抢焦点 -->
            <Grid Grid.Row="0" Height="40">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="&#x1F4CC;" FontSize="14" VerticalAlignment="Center" Margin="14,0,8,0"/>
                <TextBlock Grid.Column="1" Text="置顶文本" Foreground="{DynamicResource Theme.TextStrong}" FontSize="13"
                           FontWeight="SemiBold" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="2,0,8,0">
                    <Button x:Name="PinButton" Style="{StaticResource IconButton}" Content="&#x1F4CC;"
                            ToolTip="取消置顶" Click="OnPinClick"/>
                    <Button Style="{StaticResource IconButton}" Content="&#x2699;"
                            ToolTip="设置" Click="OnSettingsClick"/>
                    <Button Style="{StaticResource IconButton}" Content="&#x2715;"
                            ToolTip="隐藏到托盘" Click="OnHideClick"/>
                </StackPanel>
            </Grid>

            <!-- 正文：可编辑的纯文本框 -->
            <TextBox x:Name="EditorBox" Grid.Row="1"
                     Margin="12,0,12,0"
                     AcceptsReturn="True" AcceptsTab="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Disabled"
                     Background="{DynamicResource Theme.EditorBg}" Foreground="{DynamicResource Theme.TextInput}" CaretBrush="{DynamicResource Theme.TextInput}"
                     BorderThickness="0" Padding="8,6"
                     FontSize="13"
                     TextChanged="OnEditorTextChanged"
                     PreviewMouseLeftButtonDown="OnEditorPreviewMouseLeftButtonDown"
                     PreviewKeyDown="OnEditorPreviewKeyDown"
                     GotKeyboardFocus="OnEditorGotKeyboardFocus"
                     LostKeyboardFocus="OnEditorLostKeyboardFocus"/>

            <!-- 状态栏 + 右下角缩放柄 -->
            <Grid Grid.Row="2" Margin="14,4,4,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" Grid.Column="0" Foreground="{DynamicResource Theme.TextMuted}" FontSize="11"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="HintText" Grid.Column="1" Foreground="{DynamicResource Theme.TextFaint}" FontSize="11"
                           VerticalAlignment="Center" Margin="8,0,8,0"/>
                <Border x:Name="ResizeHandle" Grid.Column="2" Width="18" Height="18"
                        Background="Transparent" Cursor="SizeNWSE"
                        ToolTip="拖动调整窗口大小"
                        MouseLeftButtonDown="OnResizeStart">
                    <Path Data="M 2,16 L 16,2 M 8,16 L 16,8" Stroke="{DynamicResource Theme.TextMuted}" StrokeThickness="1.4"
                          HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>