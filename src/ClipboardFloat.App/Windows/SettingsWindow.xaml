<Window x:Class="ClipboardFloat.App.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ClipboardFloat 设置"
        Icon="pack://application:,,,/Assets/app.ico"
        Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="#1B1B2F" Foreground="#E6E8F0" FontSize="12">
    <Window.Resources>
        <!-- 深色 CheckBox：内容文字浅色 -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#E6E8F0"/>
            <Setter Property="Margin" Value="0,3,0,6"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- 深色 Button -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="#2E2E48"/>
            <Setter Property="Foreground" Value="#E6E8F0"/>
            <Setter Property="BorderBrush" Value="#3A3A58"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3A3A58"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#24243C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 深色 TextBox -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#2E2E48"/>
            <Setter Property="Foreground" Value="#F2F2F2"/>
            <Setter Property="CaretBrush" Value="#F2F2F2"/>
            <Setter Property="BorderBrush" Value="#3A3A58"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </Window.Resources>

    <StackPanel Margin="22,18,22,16">
        <TextBlock Text="常规" FontWeight="SemiBold" FontSize="13" Foreground="#F2F2F2" Margin="0,0,0,8"/>
        <CheckBox x:Name="AutoPasteCheck" Content="自动粘贴：点击历史条目后自动粘贴到前台窗口"
                  Checked="OnAutoPasteChanged" Unchecked="OnAutoPasteChanged"/>
        <CheckBox x:Name="PinnedCheck" Content="悬浮窗置顶（始终保持在上层）"
                  Checked="OnPinnedChanged" Unchecked="OnPinnedChanged"/>
        <CheckBox x:Name="MonitorCheck" Content="监听剪贴板（关闭后不记录新的复制内容）"
                  Checked="OnMonitorChanged" Unchecked="OnMonitorChanged"/>
        <CheckBox x:Name="AutoStartCheck" Content="开机自动启动"
                  Checked="OnAutoStartChanged" Unchecked="OnAutoStartChanged"/>
        <TextBlock x:Name="AutoStartTip" Foreground="#8A90A6" FontSize="11" Margin="22,0,0,6" TextWrapping="Wrap"/>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="历史条数上限：" Foreground="#E6E8F0" VerticalAlignment="Center"/>
            <TextBox x:Name="MaxHistoryBox" Grid.Column="1" Width="90" HorizontalAlignment="Left"
                     Padding="6,3" Margin="10,0,0,0"
                     LostFocus="OnMaxHistoryLostFocus" KeyDown="OnMaxHistoryKeyDown"/>
        </Grid>

        <TextBlock Text="全局热键" FontWeight="SemiBold" FontSize="13" Foreground="#F2F2F2" Margin="0,16,0,6"/>
        <Grid Margin="0,2,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="呼出/收起面板" Foreground="#E6E8F0" VerticalAlignment="Center"/>
            <Button x:Name="PanelHotkeyButton" Grid.Column="1" Width="170" HorizontalAlignment="Left"
                    Click="OnRecordPanelHotkey"/>
        </Grid>
        <Grid Margin="0,2,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="粘贴最新内容" Foreground="#E6E8F0" VerticalAlignment="Center"/>
            <Button x:Name="PasteHotkeyButton" Grid.Column="1" Width="170" HorizontalAlignment="Left"
                    Click="OnRecordPasteHotkey"/>
        </Grid>
        <Grid Margin="0,2,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="查看选中内容" Foreground="#E6E8F0" VerticalAlignment="Center"/>
            <Button x:Name="ViewHotkeyButton" Grid.Column="1" Width="170" HorizontalAlignment="Left"
                    Click="OnRecordViewHotkey"/>
        </Grid>
        <TextBlock x:Name="HotkeyWarningText" Foreground="#FFB454" FontSize="11" TextWrapping="Wrap"
                   Margin="0,4,0,0" Visibility="Collapsed"/>
        <TextBlock Text="点击热键按钮后按下新组合键（需含 Ctrl/Alt/Shift/Win 之一）。" Foreground="#8A90A6" FontSize="11" Margin="0,4,0,0"/>
        <TextBlock Text="在任意编辑器选中文字后按『查看选中内容』热键：自动复制并打开置顶查看窗口。" Foreground="#8A90A6" FontSize="11" Margin="0,2,0,0"/>
        <TextBlock Text="键盘输入异常时，可用 Ctrl+Alt+K 或托盘菜单重置修饰键。" Foreground="#8A90A6" FontSize="11" Margin="0,2,0,0"/>

        <TextBlock Text="数据" FontWeight="SemiBold" FontSize="13" Foreground="#F2F2F2" Margin="0,16,0,6"/>
        <TextBlock x:Name="DataDirText" Foreground="#8A90A6" TextWrapping="Wrap" Margin="0,1,0,8"/>
        <StackPanel Orientation="Horizontal">
            <Button Content="打开数据目录" Click="OnOpenDataDir" Margin="0,0,8,0"/>
            <Button Content="清空历史" Click="OnClearHistory" Foreground="#FF9A9A"/>
        </StackPanel>

        <TextBlock Text="设置修改后自动保存。" Foreground="#6A7088" FontSize="11" Margin="0,14,0,0"/>
    </StackPanel>
</Window>
