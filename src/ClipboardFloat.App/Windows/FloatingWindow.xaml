<Window x:Class="ClipboardFloat.App.Windows.FloatingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ClipboardFloat 悬浮剪贴板"
        Icon="pack://application:,,,/Assets/app.ico"
        Width="470"
        SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual" Left="120" Top="120"
        UseLayoutRounding="True"
        MouseEnter="OnWindowMouseEnter"
        MouseLeftButtonDown="OnDragStart" MouseMove="OnDragMove" MouseLeftButtonUp="OnDragEnd">
    <Window.Resources>
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#C9CDD8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="15">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#26FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3DFFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 历史条目右侧的小图标按钮（查看完整内容） -->
        <Style x:Key="SmallIconButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>

        <Style x:Key="SearchBox" TargetType="TextBox">
            <Setter Property="Background" Value="#1FFFFFFF"/>
            <Setter Property="BorderBrush" Value="#3DFFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#F2F2F2"/>
            <Setter Property="CaretBrush" Value="#F2F2F2"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" CornerRadius="7"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SelectableText" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="IsReadOnlyCaretVisible" Value="True"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Hidden"/>
            <!-- 禁用默认右键菜单：右键条目任意位置都弹出条目的操作菜单 -->
            <Setter Property="ContextMenu" Value="{x:Null}"/>
        </Style>

        <Style x:Key="HistoryItem" TargetType="ListBoxItem">            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="6,1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="10" Padding="2">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#14FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1FFFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="RootBorder" CornerRadius="20" Background="#F21B1B2F"
            BorderBrush="#40FFFFFF" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 常驻窄条 -->
            <Grid Grid.Row="0" Height="48">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="&#x1F4CB;" FontSize="17" VerticalAlignment="Center" Margin="16,0,9,0"/>
                <TextBlock Grid.Column="1" Text="剪贴板" Foreground="#F2F2F2" FontSize="13"
                           FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,14,0"/>
                <TextBlock x:Name="HintText" Grid.Column="2" Text="Ctrl+Shift+V 呼出历史 · 不抢焦点"
                           Foreground="#9AA0B4" FontSize="11" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="2,0,10,0">
                    <Button x:Name="PinButton" Style="{StaticResource IconButton}" Content="&#x1F4CC;"
                            ToolTip="取消置顶" Click="OnPinClick"/>
                    <Button x:Name="ExpandButton" Style="{StaticResource IconButton}" Content="&#x25BE;"
                            ToolTip="展开历史" Click="OnExpandClick"/>
                    <Button x:Name="AutoPasteButton" Style="{StaticResource IconButton}" Content="&#x21B5;"
                            ToolTip="自动粘贴" Click="OnAutoPasteClick"/>
                    <Button Style="{StaticResource IconButton}" Content="&#x2699;" Opacity="0.6"
                            ToolTip="设置（后续版本）" Click="OnSettingsClick"/>
                    <Button Style="{StaticResource IconButton}" Content="&#x2715;"
                            ToolTip="隐藏到托盘" Click="OnHideClick"/>
                </StackPanel>
            </Grid>

            <!-- 展开的历史面板 -->
            <Grid x:Name="ExpandedPanel" Grid.Row="1" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="14,8,10,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="剪贴板历史" Foreground="#F2F2F2" FontSize="13" FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                    <TextBox x:Name="SearchBox" Grid.Column="1" Height="26" Margin="12,0,8,0"
                             Style="{StaticResource SearchBox}"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="搜索历史（Esc 关闭）"
                             GotKeyboardFocus="OnSearchGotKeyboardFocus"
                             LostKeyboardFocus="OnSearchLostKeyboardFocus"
                             KeyDown="OnSearchKeyDown"/>
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button Style="{StaticResource IconButton}" Content="&#x1F5D1;"
                                ToolTip="清空历史" Click="OnClearClick"/>
                    </StackPanel>
                </Grid>

                <ListBox x:Name="HistoryList" Grid.Row="1" MaxHeight="400"
                         Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ItemsSource="{Binding Items}"
                         ItemContainerStyle="{StaticResource HistoryItem}"
                         ContextMenuOpening="OnHistoryListContextMenuOpening"
                         PreviewMouseLeftButtonDown="OnHistoryListPreviewMouseLeftButtonDown"
                         PreviewMouseMove="OnHistoryListPreviewMouseMove"
                         PreviewMouseLeftButtonUp="OnHistoryListMouseUp">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="8,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="32" Height="32" CornerRadius="8" Background="#24FFFFFF"
                                        HorizontalAlignment="Left" VerticalAlignment="Top">
                                    <Grid>
                                        <Image Source="{Binding Thumbnail}" Width="22" Height="22" Stretch="Uniform">
                                            <Image.Style>
                                                <Style TargetType="Image">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasThumbnail}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Image.Style>
                                        </Image>
                                        <TextBlock Text="{Binding KindIcon}" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="#C9CDD8" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasThumbnail}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="6,0,6,0" VerticalAlignment="Center">
                                    <TextBox Text="{Binding Preview, Mode=OneWay}" FontSize="12" Foreground="#E6E8F0"
                                             TextWrapping="Wrap" MaxHeight="34"
                                             Style="{StaticResource SelectableText}"
                                             ToolTip="{Binding Preview}"
                                             GotKeyboardFocus="OnContentGotKeyboardFocus"
                                             LostKeyboardFocus="OnContentLostKeyboardFocus"
                                             KeyDown="OnContentKeyDown"/>
                                    <TextBlock Text="{Binding Meta}" FontSize="10" Foreground="#8A90A6" Margin="0,3,0,0"/>
                                </StackPanel>
                                <Button Grid.Column="2" Style="{StaticResource SmallIconButton}"
                                        Content="&#x1F441;" ToolTip="查看完整内容"
                                        Click="OnItemViewClick" VerticalAlignment="Center"
                                        Margin="2,0,4,0"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Grid>
    </Border>
</Window>
