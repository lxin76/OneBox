<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>OneBox.Plugins.QuickNote</AssemblyName>
    <RootNamespace>OneBox.Plugins.QuickNote</RootNamespace>
    <Description>OneBox 示例小工具：同时可作为编写新插件的模板。</Description>
    <!-- exe 与任务栏图标（快速便签） -->
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\OneBox.Abstractions\OneBox.Abstractions.csproj" />
    <ProjectReference Include="..\OneBox.Plugin.Sdk\OneBox.Plugin.Sdk.csproj" />
    <ProjectReference Include="..\OneBox.Plugin.Sdk.Wpf\OneBox.Plugin.Sdk.Wpf.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 窗口 Icon 用 pack 资源；列表图标由宿主直接从 exe 的嵌入图标里取 -->
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

</Project>