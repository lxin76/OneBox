<Window x:Class="OneBox.Plugins.QuickNote.NoteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="快速便签" Width="380" Height="300"
        WindowStartupLocation="CenterScreen" Topmost="True"
        Background="#1E1E36" Foreground="#E6E8F0" FontSize="13">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBox x:Name="NoteBox" Grid.Row="0"
                 AcceptsReturn="True" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 Background="#16162A" Foreground="#F2F2F2" CaretBrush="#F2F2F2"
                 BorderBrush="#2E2E48" BorderThickness="1" Padding="8"
                 TextChanged="OnNoteTextChanged"/>

        <TextBlock Grid.Row="1" Margin="0,8,0,0" FontSize="11" Foreground="#8A90A6"
                   Text="内容自动保存。按 Ctrl+Alt+N 或托盘菜单可隐藏本窗口。"/>
    </Grid>
</Window>
