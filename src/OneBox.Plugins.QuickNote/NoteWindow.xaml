<Window x:Class="OneBox.Plugins.QuickNote.NoteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="快速便签" Width="380" Height="300"
        Icon="pack://application:,,,/Assets/app.ico"
        WindowStartupLocation="CenterScreen" Topmost="True"
        Background="{DynamicResource Theme.Card}" Foreground="{DynamicResource Theme.Text}" FontSize="13">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBox x:Name="NoteBox" Grid.Row="0"
                 AcceptsReturn="True" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 Background="{DynamicResource Theme.Window}" Foreground="{DynamicResource Theme.TextInput}" CaretBrush="{DynamicResource Theme.TextInput}"
                 BorderBrush="{DynamicResource Theme.Line}" BorderThickness="1" Padding="8"
                 TextChanged="OnNoteTextChanged"/>

        <!-- 键位由插件按实际生效的热键填入，不能写死：用户可以在工具箱里改键 -->
        <TextBlock x:Name="HintText" Grid.Row="1" Margin="0,8,0,0" FontSize="11"
                   Foreground="{DynamicResource Theme.TextMuted}"/>
    </Grid>
</Window>