<Window x:Class="OneBox.Plugins.Recorder.Windows.CompressionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="压缩录屏"
        Icon="pack://application:,,,/Assets/app.ico"
        Width="400" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        ShowInTaskbar="False" Topmost="True"
        Background="{DynamicResource Theme.Surface}"
        Foreground="{DynamicResource Theme.Text}" FontSize="12">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource Theme.ButtonBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource Theme.Text}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Theme.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Theme.ButtonHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Theme.ButtonPressed}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Theme.TextMuted}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </Window.Resources>

    <StackPanel Margin="24,20,24,18">
        <TextBlock Text="正在压缩录屏…" FontSize="15" FontWeight="SemiBold"
                   Foreground="{DynamicResource Theme.TextStrong}"/>
        <TextBlock x:Name="TargetText" Style="{StaticResource Hint}" Margin="0,5,0,0"/>
        <ProgressBar x:Name="Progress" Height="6" Margin="0,16,0,0"
                     Minimum="0" Maximum="100" IsIndeterminate="True"/>
        <TextBlock x:Name="StatusText" Style="{StaticResource Hint}" Margin="0,7,0,0"
                   Text="压缩在原文件旁边生成新文件，完成后才会决定是否删除原文件。"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="CancelButton" Content="取消" Click="OnCancel"/>
        </StackPanel>
    </StackPanel>
</Window>
