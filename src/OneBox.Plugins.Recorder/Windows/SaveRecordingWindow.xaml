<Window x:Class="OneBox.Plugins.Recorder.Windows.SaveRecordingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="保存录屏"
        Icon="pack://application:,,,/Assets/app.ico"
        Width="500" SizeToContent="Height" MaxHeight="640"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        ShowInTaskbar="False" Topmost="True"
        Background="{DynamicResource Theme.Surface}"
        Foreground="{DynamicResource Theme.Text}" FontSize="12">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource Theme.ButtonBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource Theme.Text}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Theme.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Theme.ButtonHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Theme.ButtonPressed}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource Theme.Text}"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource Theme.Text}"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="6,3"/>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource Theme.TextStrong}"/>
            <Setter Property="Margin" Value="0,18,0,8"/>
        </Style>

        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Theme.TextMuted}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </Window.Resources>

    <StackPanel Margin="24,20,24,18">
        <TextBlock Text="录制完成" FontSize="17" FontWeight="SemiBold"
                   Foreground="{DynamicResource Theme.TextStrong}"/>
        <TextBlock x:Name="SummaryText" Style="{StaticResource Hint}" Margin="0,5,0,0"/>

        <Border Background="{DynamicResource Theme.Card}" CornerRadius="8" Padding="14,11" Margin="0,14,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="当前画质" Foreground="{DynamicResource Theme.TextMuted}"
                           Margin="0,0,14,4"/>
                <TextBlock x:Name="QualityText" Grid.Column="1" TextWrapping="Wrap" Margin="0,0,0,4"/>

                <TextBlock Text="保存位置" Grid.Row="1" Foreground="{DynamicResource Theme.TextMuted}"
                           Margin="0,0,14,0"/>
                <TextBlock x:Name="PathText" Grid.Row="1" Grid.Column="1" FontSize="11"
                           Foreground="{DynamicResource Theme.TextMuted}" TextWrapping="Wrap"/>
            </Grid>
        </Border>

        <TextBlock Text="保存方式" Style="{StaticResource SectionTitle}"/>
        <RadioButton x:Name="KeepRadio" Content="保持当前画质（不压缩）" Checked="OnModeChanged"/>
        <RadioButton x:Name="CompressRadio" Content="压缩后保存" Margin="0,9,0,0"
                     Checked="OnModeChanged"/>
        <StackPanel x:Name="CompressPanel" Margin="24,8,0,0" IsEnabled="False">
            <ComboBox x:Name="TargetBox" DisplayMemberPath="Label" SelectionChanged="OnTargetChanged"/>
            <TextBlock x:Name="TargetHint" Style="{StaticResource Hint}" Margin="0,4,0,0"/>
            <CheckBox x:Name="KeepOriginalCheck" Content="压缩成功后保留原始文件" Margin="0,9,0,0"/>
        </StackPanel>
        <TextBlock x:Name="NoTargetHint" Style="{StaticResource Hint}" Visibility="Collapsed"
                   Margin="24,4,0,0"
                   Text="当前录制已经是最低档，没有更小的压缩档位；将保持当前画质保存。"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="暂不压缩" Click="OnKeepOriginal" Margin="0,0,8,0"/>
            <Button Content="保存" Click="OnSave" IsDefault="True"/>
        </StackPanel>
    </StackPanel>
</Window>
