<Window x:Class="OneBox.Plugins.Recorder.Windows.RecordingBarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OneBox 录屏"
        Width="236" Height="48"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True"
        ResizeMode="NoResize" WindowStartupLocation="Manual"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <Style x:Key="BarButton" TargetType="Button">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#F5F7FF"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="15" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#22FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#38FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- 悬浮控制条是盖在别人内容上的浮层，固定深色，不跟宿主主题走 -->
    <Border CornerRadius="24" Background="#FF1A1A24" BorderBrush="#44FFFFFF" BorderThickness="1">
        <Grid Margin="14,0,8,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧同时充当拖动把手 -->
            <Border Grid.Column="0" Background="Transparent"
                    MouseLeftButtonDown="OnDragAreaMouseDown"
                    ToolTip="拖动可移动控制条">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="RecordDot" Width="9" Height="9" Fill="#FF5B5B"
                             VerticalAlignment="Center"/>
                    <TextBlock x:Name="ElapsedText" Text="00:00"
                               Margin="10,0,0,0" VerticalAlignment="Center"
                               FontFamily="Consolas" FontSize="13" Foreground="#F5F7FF"/>
                </StackPanel>
            </Border>

            <Button x:Name="PauseButton" Grid.Column="1" Style="{StaticResource BarButton}"
                    Click="OnPauseClick" Content="&#xE769;" FontFamily="Segoe MDL2 Assets"
                    FontSize="13" ToolTip="暂停录制" AutomationProperties.Name="暂停录制"/>
            <Button x:Name="StopButton" Grid.Column="2" Style="{StaticResource BarButton}"
                    Click="OnStopClick" Content="&#xE71A;" FontFamily="Segoe MDL2 Assets"
                    FontSize="12" Foreground="#FF8A8A" ToolTip="停止并保存"
                    AutomationProperties.Name="停止录制"/>
        </Grid>
    </Border>
</Window>
