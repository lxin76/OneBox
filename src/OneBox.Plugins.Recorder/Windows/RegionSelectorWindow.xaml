<Window x:Class="OneBox.Plugins.Recorder.Windows.RegionSelectorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="选择录制区域"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize"
        WindowStartupLocation="Manual" Cursor="Cross"
        UseLayoutRounding="True">
    <Grid x:Name="RootGrid" Background="#01000000">
        <!-- 整屏暗化，选区用 EvenOdd 挖空，框内保持原样便于取景 -->
        <Path x:Name="Dimmer" Fill="#8C000000">
            <Path.Data>
                <GeometryGroup FillRule="EvenOdd">
                    <RectangleGeometry x:Name="FullGeometry"/>
                    <RectangleGeometry x:Name="HoleGeometry" Rect="0,0,0,0"/>
                </GeometryGroup>
            </Path.Data>
        </Path>

        <Border x:Name="SelectionBorder" Visibility="Collapsed"
                HorizontalAlignment="Left" VerticalAlignment="Top"
                BorderBrush="#FFFF5B5B" BorderThickness="2" Background="Transparent"
                IsHitTestVisible="False"/>

        <Border x:Name="SizeTip" Visibility="Collapsed" Background="#E6181828"
                BorderBrush="#66FF5B5B" BorderThickness="1" CornerRadius="6"
                Padding="8,3" IsHitTestVisible="False">
            <TextBlock x:Name="SizeTipText" Foreground="#F2F2F2" FontSize="12"
                       FontFamily="Consolas"/>
        </Border>

        <Border Background="#E6181828" CornerRadius="10" Padding="14,9"
                HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,56"
                IsHitTestVisible="False">
            <StackPanel>
                <TextBlock Foreground="#F2F2F2" FontSize="13" HorizontalAlignment="Center"
                           Text="拖动鼠标框选要录制的区域"/>
                <TextBlock Foreground="#9AA0B4" FontSize="11" Margin="0,3,0,0"
                           HorizontalAlignment="Center"
                           Text="右键 / Esc 取消 · 只录一块屏幕，跨屏时取重叠面积最大的那块"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
