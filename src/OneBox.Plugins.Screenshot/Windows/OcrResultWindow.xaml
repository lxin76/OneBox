<Window x:Class="OneBox.Plugins.Screenshot.Windows.OcrResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="识图取字"
        Icon="pack://application:,,,/Assets/app.ico"
        Width="520" Height="420" MinWidth="360" MinHeight="240"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Theme.Surface}" Foreground="{DynamicResource Theme.Text}" FontSize="12">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource Theme.ButtonBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource Theme.Text}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Theme.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Theme.ButtonHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Theme.ButtonPressed}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource Theme.InputBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource Theme.TextInput}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource Theme.TextInput}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Theme.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </Window.Resources>

    <DockPanel Margin="12">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <Button x:Name="PinButton" DockPanel.Dock="Right" Width="34" Content="&#x1F4CC;"
                    ToolTip="置顶" Click="OnPinClick"/>
            <Button x:Name="CopyAllButton" DockPanel.Dock="Right" Content="复制全部"
                    Margin="0,0,8,0" Click="OnCopyAllClick"/>
            <Button x:Name="CopyLinesButton" DockPanel.Dock="Right" Content="复制为单行"
                    Margin="0,0,8,0" ToolTip="把换行替换为空格，便于粘贴到单行输入框"
                    Click="OnCopySingleLineClick"/>
            <TextBlock x:Name="HeaderText" VerticalAlignment="Center" Foreground="{DynamicResource Theme.TextMuted}"
                       Text="识别结果"/>
        </DockPanel>

        <TextBlock x:Name="StatusText" DockPanel.Dock="Bottom" Margin="0,6,0,0"
                   Foreground="{DynamicResource Theme.TextMuted}" FontSize="11" TextWrapping="Wrap"/>

        <TextBox x:Name="ResultBox" AcceptsReturn="True" AcceptsTab="True"
                 TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                 Padding="8,6" FontSize="13" IsReadOnly="False"/>
    </DockPanel>
</Window>