<Window x:Class="OneBox.Plugins.Screenshot.Windows.ScreenshotSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OneBox 截图设置"
        Icon="pack://application:,,,/Assets/app.ico"
        Width="520" SizeToContent="Height" MaxHeight="720"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" ShowInTaskbar="True"
        Background="#1B1B2F" Foreground="#E6E8F0" FontSize="12">
    <Window.Resources>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#E6E8F0"/>
            <Setter Property="Margin" Value="0,3,0,6"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="#2E2E48"/>
            <Setter Property="Foreground" Value="#E6E8F0"/>
            <Setter Property="BorderBrush" Value="#3A3A58"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3A3A58"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#24243C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#2E2E48"/>
            <Setter Property="Foreground" Value="#F2F2F2"/>
            <Setter Property="CaretBrush" Value="#F2F2F2"/>
            <Setter Property="BorderBrush" Value="#3A3A58"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="5,3"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="6,3"/>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#F2F2F2"/>
            <Setter Property="Margin" Value="0,16,0,8"/>
        </Style>

        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8A90A6"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
        <StackPanel Margin="22,18,22,18">
            <TextBlock Text="截图" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>

            <TextBlock Text="保存目录：" Foreground="#E6E8F0" Margin="0,2,0,3"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="SaveDirBox" Grid.Column="0"/>
                <Button Grid.Column="1" Content="浏览…" Margin="6,0,0,0" Click="OnBrowseSaveDir"/>
                <Button Grid.Column="2" Content="打开" Margin="6,0,0,0" Click="OnOpenSaveDir"/>
            </Grid>
            <TextBlock x:Name="SaveDirHint" Style="{StaticResource Hint}" Margin="0,3,0,0"
                       Text="留空则保存到插件数据目录下的 shots 子目录。"/>

            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="文件名模板：" VerticalAlignment="Center"/>
                <TextBox x:Name="TemplateBox" Grid.Column="1" Margin="8,0,0,0"/>
                <TextBlock Text="格式：" Grid.Column="2" VerticalAlignment="Center" Margin="12,0,6,0"/>
                <ComboBox x:Name="FormatBox" Grid.Column="3" Width="90" SelectionChanged="OnFormatChanged">
                    <ComboBoxItem Content="PNG"/>
                    <ComboBoxItem Content="JPEG"/>
                </ComboBox>
            </Grid>
            <TextBlock Style="{StaticResource Hint}" Margin="0,3,0,0"
                       Text="模板支持时间占位符：{yyyy} {MM} {dd} {HH} {mm} {ss} {fff}，例如 Shot_{yyyyMMdd_HHmmss}。"/>

            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="JPEG 质量：" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
                    <Slider x:Name="QualitySlider" Width="180" Minimum="40" Maximum="100"
                            TickFrequency="1" IsSnapToTickEnabled="True"
                            VerticalAlignment="Center"/>
                    <TextBlock x:Name="QualityText" VerticalAlignment="Center" Margin="8,0,0,0"
                               Foreground="#B9BFD0"/>
                </StackPanel>
            </Grid>

            <CheckBox x:Name="CopyCheck" Content="截图后自动复制到剪贴板" Margin="0,12,0,4"
                      Checked="OnCopyChanged" Unchecked="OnCopyChanged"/>
            <CheckBox x:Name="PinCheck" Content="贴图默认置顶（始终浮在其它窗口最上层）"
                      Checked="OnPinChanged" Unchecked="OnPinChanged"/>

            <TextBlock Text="滚动截长图" Style="{StaticResource SectionTitle}"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="每次滚动：" VerticalAlignment="Center"/>
                <TextBox x:Name="WheelBox" Grid.Column="1" Width="52" Margin="8,0,0,0"/>
                <TextBlock Text="格" Grid.Column="2" VerticalAlignment="Center" Margin="4,0,12,0"/>
                <TextBlock x:Name="WheelHint" Grid.Column="3" VerticalAlignment="Center"
                           Style="{StaticResource Hint}"/>
            </Grid>
            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="高度上限：" VerticalAlignment="Center"/>
                <TextBox x:Name="MaxHeightBox" Grid.Column="1" Width="70" Margin="8,0,0,0"/>
                <TextBlock Text="px" Grid.Column="2" VerticalAlignment="Center" Margin="4,0,12,0"/>
                <TextBlock Grid.Column="3" VerticalAlignment="Center" Style="{StaticResource Hint}"
                           Text="达到上限自动停止，防止内存占用过高。"/>
            </Grid>

            <TextBlock Text="文字识别" Style="{StaticResource SectionTitle}"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="识别语言：" VerticalAlignment="Center"/>
                <ComboBox x:Name="OcrLanguageBox" Grid.Column="1" Margin="8,0,0,0"/>
            </Grid>
            <TextBlock x:Name="OcrHint" Style="{StaticResource Hint}" Margin="0,3,0,0"/>
            <CheckBox x:Name="StripSpacesCheck" Content="去掉中文之间的空格（推荐）"
                      Margin="0,8,0,0"
                      Checked="OnStripSpacesChanged" Unchecked="OnStripSpacesChanged"/>
            <CheckBox x:Name="EnhanceCheck" Content="小字图像增强（文字偏小时放大后再识别）"
                      Margin="0,4,0,0"
                      Checked="OnEnhanceChanged" Unchecked="OnEnhanceChanged"/>

            <TextBlock Text="全局热键" Style="{StaticResource SectionTitle}"/>
            <Grid Margin="0,2,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="区域截图" VerticalAlignment="Center"/>
                <Button x:Name="RegionHotkeyButton" Grid.Column="1" Width="180"
                        HorizontalAlignment="Left" Click="OnRecordRegionHotkey"/>
            </Grid>
            <Grid Margin="0,2,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="全屏截图" VerticalAlignment="Center"/>
                <Button x:Name="FullHotkeyButton" Grid.Column="1" Width="180"
                        HorizontalAlignment="Left" Click="OnRecordFullHotkey"/>
            </Grid>
            <Grid Margin="0,2,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="滚动截长图" VerticalAlignment="Center"/>
                <Button x:Name="ScrollHotkeyButton" Grid.Column="1" Width="180"
                        HorizontalAlignment="Left" Click="OnRecordScrollHotkey"/>
            </Grid>
            <Grid Margin="0,2,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="识别剪贴板图片" VerticalAlignment="Center"/>
                <Button x:Name="OcrHotkeyButton" Grid.Column="1" Width="180"
                        HorizontalAlignment="Left" Click="OnRecordOcrHotkey"/>
            </Grid>
            <TextBlock x:Name="HotkeyWarningText" Foreground="#FFB454" FontSize="11"
                       TextWrapping="Wrap" Margin="0,4,0,0" Visibility="Collapsed"/>
            <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0"
                       Text="点击热键按钮后按下新组合键（需含 Ctrl/Alt/Shift/Win 之一），Esc 取消。"/>

            <TextBlock Text="数据" Style="{StaticResource SectionTitle}"/>
            <TextBlock x:Name="DataDirText" Style="{StaticResource Hint}" Margin="0,1,0,8"/>
            <StackPanel Orientation="Horizontal">
                <Button Content="打开数据目录" Click="OnOpenDataDir" Margin="0,0,8,0"/>
                <Button Content="打开截图目录" Click="OnOpenShotsDir" Margin="0,0,8,0"/>
                <Button Content="恢复默认设置" Click="OnResetSettings" Foreground="#FFB454"/>
            </StackPanel>

            <TextBlock Text="设置修改后自动保存。" Style="{StaticResource Hint}" Margin="0,14,0,0"/>
        </StackPanel>
    </ScrollViewer>
</Window>