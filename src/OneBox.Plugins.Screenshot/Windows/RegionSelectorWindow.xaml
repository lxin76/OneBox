<Window x:Class="OneBox.Plugins.Screenshot.Windows.RegionSelectorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="区域截图"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        Cursor="Cross"
        UseLayoutRounding="True">
    <Grid x:Name="RootGrid" Background="#01000000">
        <!-- 整屏暗化：选区用 EvenOdd 挖空，选区内保持原样，方便精确取景 -->
        <Path x:Name="Dimmer" Fill="#88000000">
            <Path.Data>
                <GeometryGroup FillRule="EvenOdd">
                    <RectangleGeometry x:Name="FullGeometry"/>
                    <RectangleGeometry x:Name="HoleGeometry" Rect="0,0,0,0"/>
                </GeometryGroup>
            </Path.Data>
        </Path>

        <!-- 选区边框 -->
        <Border x:Name="SelectionBorder" Visibility="Collapsed"
                BorderBrush="#FF3B82F6" BorderThickness="1" Background="Transparent"
                IsHitTestVisible="False"/>

        <!-- 尺寸提示 -->
        <Border x:Name="SizeTip" Visibility="Collapsed" Background="#E6181828"
                BorderBrush="#553B82F6" BorderThickness="1" CornerRadius="6"
                Padding="8,3" IsHitTestVisible="False">
            <TextBlock x:Name="SizeTipText" Foreground="#F2F2F2" FontSize="12"/>
        </Border>

        <!-- 十字辅助线 -->
        <Line x:Name="GuideH" Stroke="#803B82F6" StrokeThickness="1" Visibility="Collapsed"
              IsHitTestVisible="False"/>
        <Line x:Name="GuideV" Stroke="#803B82F6" StrokeThickness="1" Visibility="Collapsed"
              IsHitTestVisible="False"/>

        <!-- 操作提示 -->
        <Border x:Name="HintPanel" Background="#E6181828" CornerRadius="8" Padding="12,7"
                HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,48"
                IsHitTestVisible="False">
            <StackPanel>
                <TextBlock Foreground="#F2F2F2" FontSize="13" HorizontalAlignment="Center"
                           Text="拖动鼠标选择区域 · 单击选取窗口 · 右键/Esc 取消"/>
                <TextBlock x:Name="HintSubText" Foreground="#9AA0B4" FontSize="11" Margin="0,3,0,0"
                           HorizontalAlignment="Center" Text="按 Enter 确认 · 按 Space 切换窗口吸附"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
