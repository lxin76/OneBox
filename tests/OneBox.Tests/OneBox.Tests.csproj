<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- IDisposable 测试类清理方法（xUnit1013 误报） -->
    <NoWarn>$(NoWarn);xUnit1013</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <!-- 直接测试截图的 Win32 适配边界；不依赖更高 Windows SDK 的 WPF 插件项目。 -->
    <Compile Include="..\..\src\OneBox.Plugins.Screenshot\Services\Native.cs" Link="ScreenshotNative\Native.cs" />
    <Compile Include="..\..\src\OneBox.Plugins.Screenshot\Services\ScrollInjector.cs" Link="ScreenshotNative\ScrollInjector.cs" />
    <Compile Include="..\..\src\OneBox.Plugins.Screenshot\Services\AppLog.cs" Link="ScreenshotNative\AppLog.cs" />
    <Compile Include="..\..\src\OneBox.Plugins.Screenshot\Services\ScrollOcclusionGuard.cs" Link="ScreenshotNative\ScrollOcclusionGuard.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\OneBox.Abstractions\OneBox.Abstractions.csproj" />
    <ProjectReference Include="..\..\src\OneBox.Plugin.Sdk\OneBox.Plugin.Sdk.csproj" />
    <ProjectReference Include="..\..\src\OneBox.Host\OneBox.Host.csproj" />
    <ProjectReference Include="..\..\src\OneBox.Plugins.TextPin.Core\OneBox.Plugins.TextPin.Core.csproj" />
    <ProjectReference Include="..\..\src\OneBox.Plugins.TextPin\OneBox.Plugins.TextPin.csproj" />
    <ProjectReference Include="..\..\src\OneBox.Plugins.Screenshot.Core\OneBox.Plugins.Screenshot.Core.csproj" />
    <ProjectReference Include="..\..\src\OneBox.Plugins.Recorder.Core\OneBox.Plugins.Recorder.Core.csproj" />
  </ItemGroup>

</Project>
